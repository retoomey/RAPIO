<colorMap name="StdDev">
    <!-- Missing and Range Folded -->
    <colorBin upperBound="-99900" name="RF">
        <color r="211" g="211" b="211" a="255" />
    </colorBin>
    <colorBin upperBound="-99000" name="ND">
        <color r="0" g="0" b="0" a="255" />
    </colorBin>

    <!-- Colorblind-safe Sequential Range (Viridis - 10 steps) -->
    <colorBin upperBound="1.0" name="1">
        <color r="68" g="1" b="84" a="255" />
    </colorBin>
    
    <colorBin upperBound="2.0" name="2">
        <color r="72" g="40" b="120" a="255" />
    </colorBin>
    
    <colorBin upperBound="3.0" name="3">
        <color r="62" g="73" b="137" a="255" />
    </colorBin>
    
    <colorBin upperBound="4.0" name="4">
        <color r="49" g="104" b="142" a="255" />
    </colorBin>

    <colorBin upperBound="6.0" name="6">
        <color r="38" g="130" b="142" a="255" />
    </colorBin>
    
    <colorBin upperBound="8.0" name="8">
        <color r="31" g="158" b="137" a="255" />
    </colorBin>
    
    <colorBin upperBound="10.0" name="10">
        <color r="53" g="183" b="121" a="255" />
    </colorBin>
    
    <colorBin upperBound="12.0" name="12">
        <color r="110" g="206" b="88" a="255" />
    </colorBin>

    <colorBin upperBound="14.0" name="14">
        <color r="181" g="222" b="43" a="255" />
    </colorBin>

    <!-- Data > 14.0 -->
    <colorBin upperBound="999" name="> 14.0">
        <color r="253" g="231" b="37" a="255" />
    </colorBin>

    <unit name="std_dev"></unit>

</colorMap>
