<colorMap name="QCmask">
    <!-- Missing and Range Folded -->
   <colorBin upperBound="-99900" name="RF">
       <color r="211" g="211" b="211" a="255" />
   </colorBin>
   <colorBin upperBound="-99000" name="ND">
       <color r="0" g="0" b="0" a="255" />
   </colorBin>

    <!-- Colorblind-safe Negative Range -->
   <colorBin upperBound="-5.5" name="NBF">
     <color value="-6" r="240" g="228" b="66" a="255" label="NBF" />
   </colorBin>
   <colorBin upperBound="-4.5" name="CC">
    <color value="-5" r="204" g="121" b="167" a="255" label="CC" />
   </colorBin>
   <colorBin upperBound="-3.5" name="PhiDP">
    <color value="-4" r="0" g="114" b="178" a="255" label="StdPhiDP" />
   </colorBin>
   <colorBin upperBound="-2.5" name="DR">
    <color value="-3" r="86" g="180" b="233" a="255" label="DR" />
   </colorBin>
   <colorBin upperBound="-1.5" name="D+L">
    <color value="-2" r="230" g="159" b="0" a="255" label="DR+LTAR" />
   </colorBin>
   <colorBin upperBound="-0.5" name="LTAR">
    <color r="213" g="94" b="0" a="255" />
   </colorBin>

    <!-- Data >= 1 -->
   <colorBin upperBound="999" name="Valid">
   <color r="0" g="158" b="115" a="255" />
   </colorBin>

    <unit name="  "></unit>

</colorMap>
